{
  "name": "unified-landlord-center-sf",
  "version": "1.0.0",
  "description": "AI-Augmented Property Management Assistant – Telegram NLP agent for landlords powered by ERPNext + OpenAI",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "nodemon src/index.js",
    "start:web": "APP_MODE=web node src/index.js",
    "start:telegram": "APP_MODE=telegram node src/index.js",
    "start:scheduler": "APP_MODE=scheduler node src/index.js",
    "run:job": "APP_MODE=job node src/index.js",
    "test": "jest --coverage --forceExit",
    "test:watch": "jest --watch",
    "lint": "eslint 'src/**/*.js' 'tests/**/*.js'",
    "migrate": "bash scripts/run-migrations.sh",
    "setup:erpnext": "node scripts/setup-erpnext-fields.js",
    "setup:scripts": "node scripts/run-erpnext-setup.js",
    "setup:portal": "node scripts/setup-tenant-portal.js"
  },
  "keywords": [
    "property-management",
    "telegram-bot",
    "openai",
    "erpnext",
    "frappe",
    "propms",
    "nlp"
  ],
  "license": "MIT",
  "dependencies": {
    "axios": "^1.7.2",
    "dotenv": "^16.4.5",
    "express": "^5.2.1",
    "form-data": "^4.0.5",
    "https-proxy-agent": "^5.0.1",
    "node-cron": "^4.2.1",
    "node-telegram-bot-api": "^0.66.0",
    "openai": "^4.52.0",
    "pdf-lib": "^1.17.1",
    "winston": "^3.13.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "eslint": "^9.7.0",
    "jest": "^29.7.0",
    "nodemon": "^3.1.4",
    "playwright": "^1.58.2",
    "supertest": "^7.2.2"
  },
  "jest": {
    "testEnvironment": "node",
    "coverageDirectory": "coverage",
    "collectCoverageFrom": [
      "src/**/*.js",
      "!src/index.js"
    ],
    "testMatch": [
      "**/tests/**/*.test.js"
    ],
    "setupFiles": [
      "<rootDir>/tests/setup.js"
    ]
  }
}
